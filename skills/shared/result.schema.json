{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fireostendere/mcp_diptrace/skills/shared/result.schema.json",
  "title": "DipTrace MCP skill result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "status",
    "summary",
    "document",
    "evidence",
    "findings",
    "measurements",
    "actions",
    "resources",
    "skipped_checks",
    "limits"
  ],
  "properties": {
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "blocked_by_input",
        "blocked_by_capability",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": ["string", "null"]
        },
        "kind": {
          "type": ["string", "null"]
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "summary",
          "evidence_class",
          "evidence_ids",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "critical"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "$ref": "#/$defs/evidence_class"
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "value",
          "unit",
          "evidence_class",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": ["number", "string"]
          },
          "unit": {
            "type": ["string", "null"]
          },
          "evidence_class": {
            "$ref": "#/$defs/evidence_class"
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "state",
          "summary",
          "transaction_id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "previewed",
              "validated",
              "committed",
              "rolled_back",
              "refused",
              "not_applicable"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "transaction_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "evidence_class"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*://"
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_class": {
            "$ref": "#/$defs/evidence_class"
          }
        }
      }
    },
    "skipped_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "reason",
          "impact"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": ["string", "number", "integer", "boolean", "null"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "evidence_class": {
      "type": "string",
      "enum": [
        "caller",
        "document",
        "analytical",
        "heuristic",
        "external_solver",
        "operator"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_class",
        "claim",
        "source",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
