# Copy to .env (same directory) or export these in your shell.
# Values here override config/settings.yaml.

# Qdrant endpoint (docker compose maps it to localhost:6333)
QDRANT_URL=http://localhost:6333

# Collection and storage locations
KB_COLLECTION=engineering
KB_DATA_DIR=./data

# Dense embedding model (FastEmbed local ONNX; first use downloads ~130 MB)
KB_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Chunker / search budgets
#KB_CHUNK_SIZE=1600
#KB_CHUNK_OVERLAP=200
#KB_MAX_CONTEXT_TOKENS=4000
