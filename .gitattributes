* text=auto eol=lf

# DipTrace XML fixtures are checksum-bound evidence. Never let Git rewrite
# their line endings on Windows checkouts.
*.xml -text
*.dip -text
*.dch -text
*.eli -text
*.lib -text
*.dsn -text
*.ses -text
*.json -text
*.svg -text

# Production packages and their manifests are byte/checksum-bound artifacts.
fab/** -text
